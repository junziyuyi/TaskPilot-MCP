    "db:migrate:local": "wrangler d1 migrations apply taskpilot --local",
    "db:migrate:remote": "wrangler d1 migrations apply taskpilot --remote"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251106.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.50.0"
  }
}
