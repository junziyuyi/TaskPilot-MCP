{
  "name": "taskpilot",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @taskpilot/server --filter @taskpilot/web dev",
    "dev:server": "pnpm --filter @taskpilot/server dev",
    "dev:web": "pnpm --filter @taskpilot/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && stylelint \"apps/**/*.{css,vue}\"",
    "lint:eslint": "eslint .",
    "lint:style": "stylelint \"apps/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"apps/**/*.{css,vue}\" --fix",
    "lint:style:fix": "stylelint \"apps/**/*.{css,vue}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck:staged": "node scripts/type-check-staged.mjs",
    "setup-hooks": "husky && git config --local alias.cz '!pnpm cz'",
    "prepare": "pnpm setup-hooks",
    "cz": "cross-env CZ_COMMIT=1 cz",
    "test": "pnpm --filter @taskpilot/server test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate:local": "pnpm --filter @taskpilot/server db:migrate:local"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.0.0",
    "cz-git": "^1.14.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "postcss-html": "^1.8.0",
    "prettier": "^3.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.0.0",
    "stylelint-config-recommended": "^14.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^7.0.0",
    "supports-color": "7",
    "vue-eslint-parser": "^10.0.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
